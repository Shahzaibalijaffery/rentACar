{
  "name": "rentacar",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "api:dev": "npm run start:dev -w @rentacar/api",
    "api:build": "npm run build -w @rentacar/api",
    "api:test": "npm run test -w @rentacar/api",
    "api:storage-check": "npm run storage:check -w @rentacar/api",
    "api:seed": "npm run prisma:seed -w @rentacar/api",
    "mobile:start": "npm run start -w @rentacar/mobile",
    "mobile:ios": "npm run ios -w @rentacar/mobile",
    "mobile:android": "npm run android -w @rentacar/mobile",
    "shared:build": "npm run build -w @rentacar/shared",
    "render:build": "npm run shared:build && npm run api:build",
    "render:start": "npm run start:prod -w @rentacar/api",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "npm run typecheck -w @rentacar/api && npm run typecheck -w @rentacar/mobile && npm run typecheck -w @rentacar/shared"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "globals": "^16.5.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.4"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
