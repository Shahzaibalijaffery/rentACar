# Server
NODE_ENV=development
PORT=3000

# MongoDB Atlas (Prisma)
DATABASE_URL=

# JWT (use long random strings in production)
JWT_ACCESS_SECRET=change-me-access-secret-min-32-characters-long
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-characters-long
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Email verification
EMAIL_VERIFICATION_EXPIRES_HOURS=24
EMAIL_VERIFICATION_ENABLED=false
EMAIL_FROM=noreply@rentacar.com
APP_URL=http://localhost:3000

# Cloudflare R2 object storage
# Create at: R2 Overview → Manage API Tokens → Account API token → Object Read & Write
#
# Cloudflare dashboard label                              → Env var (copy to Render too)
# ─────────────────────────────────────────────────────────────────────────────────────
# S3 clients: Access Key ID                               → R2_ACCESS_KEY_ID
# S3 clients: Secret Access Key                           → R2_SECRET_ACCESS_KEY
# S3 endpoint account id (xxx.r2.cloudflarestorage.com)   → R2_ACCOUNT_ID
# Your bucket name                                        → R2_BUCKET_NAME
# Bucket → Settings → Public Development URL (r2.dev)     → R2_PUBLIC_BASE_URL
#
# NOT used by RentACar (Cloudflare REST API only — do not set as env var):
# Token value (starts with cfat_)
#
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_BASE_URL=

# SMTP (leave SMTP_HOST empty to log emails to console in development)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Area search (OpenStreetMap Nominatim — no map SDK)
GEOCODING_COUNTRY_CODES=pk
GEOCODING_USER_AGENT=RentACar/1.0 (peer-to-peer car rental)
