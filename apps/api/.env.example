# Server
NODE_ENV=development
PORT=3000

# MongoDB Atlas (Prisma)
DATABASE_URL=

# JWT (use long random strings in production)
JWT_ACCESS_SECRET=change-me-access-secret-min-32-characters-long
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-characters-long
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Email (Resend HTTPS API — not SMTP)
EMAIL_VERIFICATION_EXPIRES_HOURS=24
EMAIL_VERIFICATION_ENABLED=true
PASSWORD_RESET_EXPIRES_MINUTES=15
EMAIL_FROM=beth.t@example.com
EMAIL_FROM_NAME=RentACar
APP_URL=http://localhost:3000

# Cloudflare R2 object storage
# Create at: R2 Overview → Manage API Tokens → Account API token → Object Read & Write
#
# Cloudflare dashboard label                              → Env var (copy to Render too)
# ─────────────────────────────────────────────────────────────────────────────────────
# S3 clients: Access Key ID                               → R2_ACCESS_KEY_ID
# S3 clients: Secret Access Key                           → R2_SECRET_ACCESS_KEY
# S3 endpoint account id (xxx.r2.cloudflarestorage.com)   → R2_ACCOUNT_ID
# Your bucket name                                        → R2_BUCKET_NAME
# Bucket → Settings → Public Development URL (r2.dev)     → R2_PUBLIC_BASE_URL
#
# NOT used by RentACar (Cloudflare REST API only — do not set as env var):
# Token value (starts with cfat_)
#
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_BASE_URL=

# Resend. Leave RESEND_API_KEY empty to log emails (including the code) in the API console.
# https://resend.com/api-keys — HTTPS only, works on Render Free.
# Unverified accounts can send from beth.t@example.com to the Resend account email only.
# Custom From (e.g. noreply@yourdomain.com) requires a verified domain in Resend.
RESEND_API_KEY=

# Area search (OpenStreetMap Nominatim — no map SDK)
GEOCODING_COUNTRY_CODES=pk
GEOCODING_USER_AGENT=RentACar/1.0 (peer-to-peer car rental)

# Android FCM (optional). Live in-app updates work without this.
# Local: path to the service account JSON (file is gitignored).
# Production: paste the JSON as a single line instead.
FIREBASE_SERVICE_ACCOUNT_PATH=
FIREBASE_SERVICE_ACCOUNT_JSON=
