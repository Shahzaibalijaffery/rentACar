# Server
NODE_ENV=development
PORT=3000

# MongoDB Atlas (Prisma)
DATABASE_URL=

# JWT (use long random strings in production)
JWT_ACCESS_SECRET=change-me-access-secret-min-32-characters-long
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-characters-long
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Email verification
EMAIL_VERIFICATION_EXPIRES_HOURS=24
EMAIL_VERIFICATION_ENABLED=false
EMAIL_FROM=noreply@rentacar.com
APP_URL=http://localhost:3000

# Local object storage (development). Use S3-compatible storage in production.
STORAGE_LOCAL_DIR=./storage
STORAGE_PUBLIC_BASE_URL=http://localhost:3000/api/v1/files

# SMTP (leave SMTP_HOST empty to log emails to console in development)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
